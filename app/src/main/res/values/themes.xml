<resources>
    <!-- Base application theme. -->
    <style name="Theme.DSUHelper" parent="Theme.Material3.DayNight">

        <item name="colorPrimary">@color/system_accent</item>
        <item name="colorPrimaryDark">@color/system_accent_darker</item>
        <item name="colorSecondary">@color/system_accent_2</item>

        <item name="colorError">@color/error</item>

        <item name="colorPrimaryVariant">@color/system_accent</item>
        <item name="colorSecondaryVariant">@color/system_accent_2</item>
        <item name="scrimBackground">@color/netrual_color</item>

        <item name="colorSurface">@color/netrual_color</item>
        <item name="colorSecondaryContainer">@color/system_accent_soft</item>

        <item name="android:colorBackground">@color/background</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <!-- Both bars are transparent, so their icons have to be dark on a light
             background. The theme covers the launch window, before the first
             composition applies the same polarity from the resolved color scheme;
             without windowLightNavigationBar the gesture pill started off white on
             white. enforceNavigationBarContrast matches Theme.kt, otherwise the
             platform paints a grey band behind the transparent bar until then. -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:enforceNavigationBarContrast">false</item>

    </style>
</resources>